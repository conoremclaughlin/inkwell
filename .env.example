# Server Configuration
NODE_ENV=development
# Optional base port for local multi-instance runs:
#   MCP_HTTP_PORT=INK_PORT_BASE
#   WEB_PORT=INK_PORT_BASE+1
#   MYRA_HTTP_PORT=INK_PORT_BASE+2
#   PORT defaults to INK_PORT_BASE-1 (if needed)
INK_PORT_BASE=3001

# Which ink CLI the server invokes for hooks and chat loops. Default: this
# checkout's packages/cli/dist/cli.js. The server never uses ~/.ink/bin/ink.
# INK_CLI_PATH=/absolute/path/to/packages/cli/dist/cli.js
PORT=3000

# HTTP request budgets (per process/socket IP; changes require a server restart).
# Direct loopback clients are exempt; forwarded/proxied requests are not.
# Disable the exemption when a local proxy strips forwarding indicators.
# INK_HTTP_RATE_LIMIT_MAX=1200
# INK_HTTP_RATE_LIMIT_WINDOW_MS=60000
# INK_OAUTH_RATE_LIMIT_MAX=60
# INK_OAUTH_RATE_LIMIT_WINDOW_MS=60000
# INK_RATE_LIMIT_EXEMPT_LOOPBACK=true
# See docs/security/codeql-priority.md and ink://specs/http-rate-limiting.

# Database - Supabase (use newer naming convention)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key
# Optional local references written by `yarn supabase:local:setup` when canonical keys already exist:
# LOCAL_SUPABASE_URL=http://127.0.0.1:54321
# LOCAL_SUPABASE_PUBLISHABLE_KEY=your-local-publishable-key
# LOCAL_SUPABASE_SECRET_KEY=your-local-secret-key

# Legacy Supabase keys (fallback - use above instead)
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_KEY=your-service-key

# Telegram Bot (optional - for Telegram integration)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_BENSON_BOT_TOKEN=your-secondary-bot-token
TELEGRAM_WEBHOOK_URL=https://your-domain.com/webhooks/telegram
# Optional explicit toggle (defaults to true when TELEGRAM_BOT_TOKEN is set)
# ENABLE_TELEGRAM=false

# MCP Server
MCP_TRANSPORT=stdio  # stdio or http
MCP_HTTP_PORT=3001
MCP_REQUIRE_OAUTH=true  # for HTTP transport: challenge unauthenticated clients with OAuth

# Myra (persistent messaging process)
MYRA_HTTP_PORT=3003

# Web dashboard (derived from INK_PORT_BASE + 1 if unset)
WEB_PORT=3002

# Heartbeat / Reminders
# Disable on secondary dev servers to avoid misrouting reminder wake-ups
# (e.g., when running dev:direct from a personal studio).
ENABLE_HEARTBEATS=true
# Optional local scheduler toggle (defaults to true in development, false in production)
# ENABLE_LOCAL_CRON=true

# Authentication
JWT_SECRET=your-jwt-secret-key-min-32-chars-long
# Optional local reference written by `yarn supabase:local:setup` when JWT_SECRET already exists:
# LOCAL_JWT_SECRET=your-local-jwt-secret
JWT_EXPIRES_IN=7d

# Logging & Monitoring
LOG_LEVEL=info
# SENTRY_DSN=https://your-sentry-dsn

# Inbound media preprocessing (audio/image/video)
# AUDIO_TRANSCRIPTION_ENABLED=true
# AUDIO_TRANSCRIPTION_PROVIDERS=openai,cli
# AUDIO_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# AUDIO_TRANSCRIPTION_CLI_COMMAND=whisper {input} --output_format txt --output_dir /tmp && cat /tmp/$(basename {input} .ogg).txt
# MEDIA_UNDERSTANDING_ENABLED=true
# MEDIA_UNDERSTANDING_PROVIDERS=openai,cli
# MEDIA_UNDERSTANDING_MODEL=gpt-4.1-mini
# MEDIA_IMAGE_ANALYSIS_CLI_COMMAND=tesseract {input} stdout
# MEDIA_VIDEO_ANALYSIS_CLI_COMMAND=python3 scripts/video_analyze.py {input}

# Outbound Telegram voice replies
# AUDIO_TTS_ENABLED=true
# AUDIO_TTS_PROVIDERS=openai,cli
# AUDIO_TTS_MODEL=gpt-4o-mini-tts
# AUDIO_TTS_VOICE=alloy
# AUDIO_TTS_FORMAT=opus
# AUDIO_TTS_CLI_COMMAND=python3 scripts/tts_fallback.py --text {text} --output {output} --format {format}
# TELEGRAM_AUTO_VOICE_REPLY=true
# TELEGRAM_VOICE_INCLUDE_TEXT=true

# OAuth - Google (for Calendar, Gmail integration)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
OAUTH_REDIRECT_BASE_URL=http://localhost:3001
# Credential sources tried in order for Google calls: the dashboard connection
# (`cloud`) and/or desktop logins from `ink google login` (`desktop`).
# See docs/setup/google-credentials.md. Default: cloud,desktop
# GOOGLE_CREDENTIAL_SOURCES=cloud,desktop
# Where desktop logins are stored (CLI writes, server reads). Default: ~/.ink/google
# INK_GOOGLE_CREDENTIALS_DIR=
